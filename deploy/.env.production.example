# =============================================================================
# EMB R3 OCSM – Production Environment Variables (server/.env)
# =============================================================================
# Copy this file to /opt/embr3-csm/server/.env on your VPS and fill in values.
# NEVER commit this file with real credentials to version control.
# =============================================================================

# --- Database ---
# MongoDB Atlas connection string (get from Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/db-clientsatisfactory

# --- Server ---
NODE_ENV=production
# Must match the port Nginx proxies to. The live VPS uses 5001 for OCSM
# (5000 is taken by the HRPMS app on the same host).
PORT=5001
# Bind to localhost only — Nginx handles public traffic
SERVER_HOST=127.0.0.1

# --- CORS / Frontend ---
# Replace with your actual domain (or http://YOUR_VPS_IP if no domain).
# CLIENT_ORIGIN is the browser's origin — scheme + host only, NO path and no
# port unless the site is actually served on one. A mismatch here breaks CORS
# whenever the frontend is served from a different origin than the API.
CLIENT_ORIGIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com/ocsm

# --- Authentication ---
# REQUIRED. Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# --- Email (Gmail SMTP with App Password) ---
# 1. Enable 2-Step Verification on your Gmail account
# 2. Go to myaccount.google.com → Security → App Passwords
# 3. Generate an App Password for "Mail" → "Other (custom name)"
# 4. Paste the 16-character password below (no spaces)
FORCE_SMTP=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=EMB Region III Online CSM Portal

# --- Frontend Runtime Config (sent to client via /api/config) ---
# IMPORTANT: everything below is served to any anonymous visitor by
# GET /api/config, because the browser bundle needs it. Treat these as public
# values, not secrets — they only obfuscate localStorage keys. Never put a
# real credential here, and do not commit live values to this example file.
MENU_SECRET_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME
COLOR_SCHEME_SECRET=CHANGE_ME
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
# Must match the Vite base path the frontend was built with.
# Root deployment: /     Subdirectory deployment (the live VPS): /ocsm/
FRONTEND_BASE_PATH=/ocsm/
