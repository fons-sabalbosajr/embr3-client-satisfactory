# =============================================================================
# EMB R3 OCSM – Production Environment Variables (server/.env)
# =============================================================================
# Copy this file to /opt/embr3-csm/server/.env on your VPS and fill in values.
# NEVER commit this file with real credentials to version control.
# =============================================================================

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/db-clientsatisfactory

# --- Server ---
NODE_ENV=production
PORT=5000
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# --- CORS / Frontend ---
# Replace with your actual domain (or VPS IP if no domain)
CLIENT_ORIGIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- Authentication ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# --- Email (Gmail SMTP with App Password) ---
FORCE_SMTP=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=embr3.css@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_USER=embr3.css@gmail.com
EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=EMB Region III Online CSM Portal

# --- Frontend Runtime Config ---
MENU_SECRET_KEY=s@tisf@ct0ryS3cret
SECRET_KEY=v900LHdi
COLOR_SCHEME_SECRET=mantine_dark_light_switch
EMAILJS_PUBLIC_KEY=bgYF-06ZE7QHB5_lJ
FRONTEND_BASE_PATH=/
