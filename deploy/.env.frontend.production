# =============================================================================
# EMB R3 OCSM – Frontend Production Environment Variables
# =============================================================================
# Copy this file to front-end/.env.production on your VPS before building.
# Variables must be prefixed with VITE_ to be available in the browser.
# After changing values, rebuild: cd front-end && npm run build
# =============================================================================

# --- Public URL ---
# Used for QR code generation and external links.
# Set to your domain (https://yourdomain.com) or VPS IP (http://YOUR_VPS_IP).
VITE_APP_URL=https://yourdomain.com

# --- Service Lists ---
# JSON arrays of service names displayed in the survey dropdown.
# Add/remove items without touching source code.

